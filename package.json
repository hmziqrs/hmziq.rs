{
  "name": "hmziq.rs",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/hmziqrs/hmziq.rs#readme",
  "bugs": {
    "url": "https://github.com/hmziqrs/hmziq.rs/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmziqrs/hmziq.rs.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun build:wasm:dev && vp dev",
    "build": "bun run build:wasm && bun generate:feeds && vp build",
    "generate:feeds": "bun ./scripts/generate-feeds.ts",
    "fetch:github": "bun ./scripts/fetch-github-stats.ts",
    "copy:wasm": "bun ./scripts/copy-wasm.ts",
    "build:wasm": "cd wasm && wasm-pack build --release --target web --out-dir pkg && bun copy:wasm",
    "build:wasm:dev": "cd wasm && wasm-pack build --target web --out-dir pkg --dev && bun ../scripts/copy-wasm.ts",
    "prod": "bun run build && bun preview",
    "preview": "vp preview",
    "firebase:serve": "firebase emulators:start --only hosting",
    "firebase:deploy": "firebase deploy --only hosting",
    "firebase:build-deploy": "bun run build && firebase deploy --only hosting",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "type-check": "tsc --noEmit",
    "kill-dev": "kill -9 $(lsof -ti:3000) 2>/dev/null || true"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/redact": "^0.2.3",
    "firebase": "^13.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "feed": "^6.0.0",
    "nitro": "3.0.260903-beta",
    "playwright": "^1.64.1",
    "sitemap": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.4.0",
    "vite-plus": "^1.4.0"
  },
  "overrides": {
    "vite": "$vite"
  }
}
